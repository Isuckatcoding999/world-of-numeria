body {
  margin: 0;
  background: radial-gradient(circle at top, #050b2e, #020417);
  font-family: 'Segoe UI', sans-serif;
  color: #e6f3ff;
}

.hud {
  text-align: center;
  padding: 30px;
  color: #7ddfff;
  text-shadow: 0 0 20px #00c8ff;
}

.map-section {
  display: flex;
  justify-content: center;
  margin-bottom: 30px;
}

.map {
  width: 90%;
  max-width: 1000px;
  border-radius: 15px;
  box-shadow: 0 0 60px rgba(0, 200, 255, 0.4);
}

.zones {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  max-width: 1000px;
  margin: auto;
  padding: 30px;
}

.zone {
  background: rgba(0, 40, 90, 0.5);
  border: 1px solid #00c8ff;
  padding: 20px;
  text-align: center;
  cursor: pointer;
  border-radius: 12px;
  transition: 0.3s;
  font-size: 18px;
}

.zone:hover {
  box-shadow: 0 0 20px #00c8ff;
  transform: scale(1.05);
}

.panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 30, 0.9);
  display: flex;
  justify-content: center;
  align-items: center;
}

.hidden {
  display: none;
}

.panel-content {
  background: #06153a;
  border: 2px solid #00c8ff;
  border-radius: 15px;
  width: 90%;
  max-width: 700px;
  padding: 30px;
  box-shadow: 0 0 40px #00c8ff;
}

.close {
  float: right;
  cursor: pointer;
  font-size: 20px;
}

.panel-content h2 {
  color: #7ddfff;
}

.panel-content li {
  margin: 8px 0;
}
